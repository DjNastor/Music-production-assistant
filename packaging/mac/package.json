{
  "name": "nastor-ai-studio-mac-catalina",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Intel Mac app for macOS Catalina — legacy beta",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac zip dmg --x64 --publish never"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "za.co.lukulu.nastoraistudio.mac",
    "productName": "Nastor AI Studio",
    "artifactName": "Nastor-AI-Studio-Mac-Catalina-0.1.0-x64.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "offline.html", "package.json"],
    "mac": {
      "category": "public.app-category.music",
      "target": ["zip", "dmg"],
      "minimumSystemVersion": "10.15.0",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nastor AI Studio uses the microphone only when you choose to record audio."
      }
    },
    "dmg": { "title": "Nastor AI Studio - Catalina beta" },
    "publish": null
  }
}
